@model Produto

@{
    var editando = Model.Id > 0;
    ViewData["Title"] = editando ? "Editar produto" : "Cadastrar produto";
    var actionName = editando ? "EditarProduto" : "CriarProduto";
}

<h1 class="titulo-pagina">@ViewData["Title"]</h1>

<p>
    <a class="link-voltar" asp-controller="Admin" asp-action="Produtos">
        ← Voltar à lista de produtos
    </a>
</p>

<div class="cartao formulario-admin">

    <form asp-controller="Admin"
          asp-action="@actionName"
          asp-route-id="@(editando ? Model.Id : null)"
          method="post">

        @if (editando)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div asp-validation-summary="All" class="validacao" role="alert"></div>

        <p class="texto-ajuda">Preencha os dados do produto e confirme em “Salvar produto”. Ele será disponibilizado na loja quando estiver ativo.</p>

        <div class="campo">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" />
            <span asp-validation-for="Nome"></span>
        </div>

        <div class="campo">
            <label asp-for="Descricao"></label>
            <textarea asp-for="Descricao" rows="3"></textarea>
            <span asp-validation-for="Descricao"></span>
        </div>

        <div class="campo">
            <label asp-for="Categoria"></label>
            <input asp-for="Categoria" list="categorias-produtos" />
            <datalist id="categorias-produtos">
                <option value="Bem-estar"></option>
                <option value="Cabelos"></option>
                <option value="Cuidados com a pele"></option>
                <option value="Higiene"></option>
            </datalist>
            <span asp-validation-for="Categoria"></span>
        </div>

        <div class="campo">
            <label asp-for="Ilustracao">Símbolo ou ilustração (texto)</label>
            <input asp-for="Ilustracao" />
            <span asp-validation-for="Ilustracao"></span>
        </div>

        <div class="campo">
            <label asp-for="Selo">Selo promocional (opcional)</label>
            <input asp-for="Selo" />
            <span asp-validation-for="Selo"></span>
        </div>

        <div class="campo">
            <label asp-for="Preco"></label>
            <input asp-for="Preco" type="number" min="0.01" step="0.01" />
            <span asp-validation-for="Preco"></span>
        </div>

        <div class="campo">
            <label asp-for="PrecoAnterior"></label>
            <input asp-for="PrecoAnterior" type="number" min="0" step="0.01" />
            <span asp-validation-for="PrecoAnterior"></span>
        </div>

        <div class="campo">
            <label asp-for="Estoque"></label>
            <input asp-for="Estoque" type="number" min="0" step="1" />
            <span asp-validation-for="Estoque"></span>
        </div>

        <div class="campo-checkbox">
            <input asp-for="Ativo" />
            <label asp-for="Ativo"></label>
        </div>

        <button type="submit" class="botao">
            Salvar produto
        </button>

    </form>

</div>
