@model CarrinhoViewModel

@{
    ViewData["Title"] = "Minha cesta";
}

<h1 class="titulo-pagina">Minha cesta</h1>

<p>
    <a class="link-voltar" asp-controller="Home" asp-action="Index">
        ← Continuar comprando
    </a>
</p>

@if (Model.Itens.Count == 0)
{
    <div class="estado-vazio">
        <span class="icone" aria-hidden="true">🛒</span>
        <h2>Sua cesta está vazia</h2>
        <p>Explore nossos produtos e adicione seus favoritos à cesta.</p>

        <a class="botao"
           asp-controller="Home"
           asp-action="Index">
            Ver produtos
        </a>
    </div>
}
else
{
    <div class="tabela-responsiva">

        <table class="tabela">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Preço unitário</th>
                    <th>Quantidade</th>
                    <th>Subtotal</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td>
                            <strong>@item.Produto.Nome</strong><br />
                            <small>@item.Produto.Categoria</small>
                        </td>
                        <td>R$ @item.Produto.Preco.ToString("N2")</td>
                        <td>@item.Quantidade</td>
                        <td><strong>R$ @item.Subtotal.ToString("N2")</strong></td>
                        <td>
                            <form asp-controller="Carrinho" asp-action="Remover" method="post">
                                <input type="hidden" name="id" value="@item.Produto.Id" />
                                <button type="submit" class="botao botao-contorno botao-pequeno">
                                    Remover uma unidade
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

    <div class="resumo-compra">

        <p class="total">
            @Model.QuantidadeTotal @(Model.QuantidadeTotal == 1 ? "item" : "itens") na cesta
            &nbsp;|&nbsp;
            Total: <strong>R$ @Model.Total.ToString("N2")</strong>
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Carrinho" asp-action="FinalizarCompra" method="post">
                <button type="submit" class="botao">
                    Confirmar pedido
                </button>
            </form>
        }
        else
        {
            <a class="botao"
               asp-controller="Conta"
               asp-action="Entrar"
               asp-route-returnUrl="@Url.Action("Index", "Carrinho")">
                Entrar para finalizar
            </a>
        }

    </div>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <p class="texto-auxiliar">
            Para confirmar o pedido, entre na sua conta. Depois, volte à cesta para finalizar.
        </p>
    }
}
